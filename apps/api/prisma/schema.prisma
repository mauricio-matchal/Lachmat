// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MASCULINO
  FEMININO
  UNISSEX
}

enum Fabric {
  ALGODAO
  POLIESTER
  LINHO
  SEDA
  LA
  VISCOSA
  NYLON
  ACRILICO
  RAYON
  TEXTIL
}

// A product line groups the colors of the same item (e.g. "Camiseta Hyverse
// Dri-FIT Masculina"), like Nike's styles: shared description and attributes
model ProductLine {
  id          String    @id @default(cuid()) // PK
  slug        String    @unique
  name        String
  description String
  //
  model       String
  gender      Gender
  fabric      Fabric
  ratingAvg   Float     @default(0)
  ratingCount Int       @default(0)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id]) // FK
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
}

// A product is one color of a line of products: it has its own page, SKU, photos and
// prices, and appears as its own card in listings
model Product {
  id         String      @id @default(cuid()) // PK
  slug       String      @unique
  sku        String      @unique
  //
  colorName  String
  colorHex   String
  images     String[] // first image is the cover
  price      Int // in cents: R$ 161,49 = 16149
  promoPrice Int?
  pixPrice   Int?
  isLaunch   Boolean     @default(false)
  lineId     String
  line       ProductLine @relation(fields: [lineId], references: [id]) // FK
  sizes      Size[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  @@index([lineId])
}

model Category {
  id    String        @id @default(cuid()) // PK
  slug  String        @unique
  name  String
  //
  lines ProductLine[]
}

model Size {
  id        String  @id @default(cuid()) // PK
  name      String
  //
  stock     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade) // FK

  @@unique([productId, name])
}
